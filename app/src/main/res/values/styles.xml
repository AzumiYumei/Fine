<resources>
    <string name="app_name" translatable="false">Fine</string>
    <color name="fine_forest">#183F36</color>
    <style name="LaunchTheme" parent="LaunchThemeBase" />
    <style name="LaunchThemeBase" parent="AppTheme">
        <item name="android:windowBackground">@drawable/fine_launch</item>
        <item name="android:statusBarColor">@color/fine_forest</item>
        <item name="android:navigationBarColor">@color/fine_forest</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="AppTheme" parent="BaseTheme" />
    <style name="BaseTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#3D6D5F</item>
        <item name="android:colorBackground">#F7F8F7</item>
        <item name="android:textColorPrimary">#28302E</item>
        <item name="android:textColorSecondary">#717A76</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F8F7</item>
        <item name="android:navigationBarColor">#28302E</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F7F8F7</item>
    </style>
    <string name="download_channel">视频下载</string>
    <string name="playback_error">播放失败：%1$s\n请检查链接、网络或视频编码是否受设备支持。</string>
</resources>
